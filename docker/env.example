# ERM Platform — production environment variables
# Copy this file to .env in the same directory before running PRODUCTION compose:
#   cp env.example .env
#
# Do not use this .env with docker-compose.dev.yml (dev uses fixed local credentials).
# Dev and prod use separate Postgres volumes (erm-platform-pgdata-dev vs -prod).
# Generate secrets:
#   openssl rand -base64 32

# --- PostgreSQL ---
POSTGRES_DB=erm_db
POSTGRES_USER=erm_user
POSTGRES_PASSWORD=change-me-use-a-strong-password

# --- Backend (Spring Boot) ---
SPRING_PROFILES_ACTIVE=prod
DB_SCHEMA=erm
JWT_SECRET=change-me-minimum-32-characters-required
JWT_EXPIRATION=86400000

# Comma-separated allowed browser origins (no trailing slash)
# HTTP local prod compose: http://localhost:4200
# HTTPS staging:       https://localhost
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Optional TLS ports when using docker-compose.tls.yml
# HTTP_PORT=80
# HTTPS_PORT=443

# Must be false in production (demo seed is dev-only)
ERM_DEMO_DATA_ENABLED=false

# --- Stripe billing (optional; leave empty to disable) ---
# STRIPE_ENABLED=true
# STRIPE_API_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...
# STRIPE_CURRENCY=eur
# STRIPE_PORTAL_RETURN_URL=http://localhost:4200/settings/billing
# STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:4200/settings/billing?checkout=success
# STRIPE_CHECKOUT_CANCEL_URL=http://localhost:4200/settings/billing?checkout=cancel

# UI help links (required for backend startup)
# UI_DOCUMENTATION_URL=https://docs.example.com
# UI_SUPPORT_URL=https://support.example.com

# Optional overrides
# SERVER_PORT=8080
# JPA_DDL_AUTO=validate
