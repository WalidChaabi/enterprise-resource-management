FROM maven:3.9.6-eclipse-temurin-17

WORKDIR /app

# Cache Maven
COPY pom.xml .
COPY .mvn .mvn
COPY mvnw mvnw
COPY mvnw.cmd mvnw.cmd

RUN mvn -B dependency:go-offline

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

EXPOSE 8080

CMD ["mvn", "spring-boot:run"]
