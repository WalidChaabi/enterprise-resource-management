# Copy to .env in this directory: cp env.example .env
# Generate JWT secret: openssl rand -base64 32

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

DB_URL=jdbc:postgresql://db:5432/erm_db
DB_USER=erm_user
DB_PASS=erm_pass
DB_SCHEMA=erm
JPA_DDL_AUTO=validate

JWT_SECRET=change-me-to-a-secret-at-least-32-chars-long
ERM_ENCRYPTION_KEY=change-me-to-an-encryption-key-at-least-32-chars
JWT_EXPIRATION=86400000

CORS_ALLOWED_ORIGINS=http://localhost:4200
FLYWAY_REPAIR_ON_MIGRATE=false
LOG_PATH=logs

ERM_DEMO_DATA_ENABLED=true
